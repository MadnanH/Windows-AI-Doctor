{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waid.local/schemas/waid-plugin-v2.schema.json",
  "title": "WAID Plugin Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","name","version","publisher","minimumHostVersion","entryAssembly","apiVersion","capabilities","permissions"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$"},
    "name": {"type":"string","minLength":1,"maxLength":120},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$"},
    "publisher": {"type":"string","minLength":1},
    "minimumHostVersion": {"type":"string"},
    "entryAssembly": {"type":"string","pattern":"^[^/\\\\]+\\.dll$"},
    "apiVersion": {"const":"2"},
    "capabilities": {"type":"array","uniqueItems":true,"minItems":1,"items":{"enum":["Scanner","ReportContributor","KnowledgeProvider","RepairModule"]}},
    "permissions": {"type":"array","uniqueItems":true,"minItems":1,"items":{"enum":["SystemRead","EnvironmentRead","EventLogRead","NetworkProbe","ReportWrite","KnowledgeRead","RepairPlan"]}},
    "dependencies": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","minimumVersion","optional"],"properties":{"id":{"type":"string"},"minimumVersion":{"type":"string"},"optional":{"type":"boolean"}}}},
    "assemblySha256": {"type":["string","null"],"pattern":"^[A-Fa-f0-9]{64}$"}
  }
}