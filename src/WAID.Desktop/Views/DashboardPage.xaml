<Page x:Class="WAID.Desktop.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><Grid Padding="32" MaxWidth="1100" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="8"><TextBlock Text="Windows AI Doctor" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="A clear, safe view of your Windows health." Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel>
    <Border Grid.Row="1" Margin="0,28,0,24" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="14"><TextBlock Text="{Binding Status}" Style="{StaticResource HeaderTextBlockStyle}"/><ProgressBar Value="{Binding Progress}" Maximum="100"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Scan this PC" Command="{Binding ScanCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel></StackPanel></Border>
    <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="Findings" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Severity}" Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
  </Grid></ScrollViewer>
</Page>
