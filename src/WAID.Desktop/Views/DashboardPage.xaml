<Page x:Class="WAID.Desktop.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><Grid Padding="32" MaxWidth="1100" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="8"><TextBlock Text="Windows AI Doctor" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="A clear, safe view of your Windows health." Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel>
    <Border Grid.Row="1" Margin="0,28,0,24" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="14"><TextBlock Text="{Binding Status}" Style="{StaticResource HeaderTextBlockStyle}" TextWrapping="Wrap"/><ProgressBar Value="{Binding Progress}" Maximum="100"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Scan this PC" Command="{Binding ScanCommand}" Style="{StaticResource AccentButtonStyle}"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Export diagnostics" Command="{Binding ExportCommand}"/></StackPanel></StackPanel></Border>
    <StackPanel Grid.Row="2" Spacing="20"><StackPanel Spacing="12"><TextBlock Text="Scan plan" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding ScannerPlan}" AutomationProperties.AutomationId="ScannerPlan"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.75"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}" HorizontalAlignment="Right"/><ProgressBar Value="{Binding Percentage}" Maximum="100"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Spacing="12"><TextBlock Text="Findings" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Severity}" Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Spacing="12"><TextBlock Text="Safe repairs" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Repairs require confirmation and administrator privileges. WAID creates safety backups before changes." TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding AvailableRepairs}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding SafetyLevel}" Opacity="0.7"/></StackPanel><Button Grid.Column="1" Content="Review and run" Click="OnRepairClick" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel>
  </Grid></ScrollViewer>
</Page>
