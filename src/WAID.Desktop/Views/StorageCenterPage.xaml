<Page x:Class="WAID.Desktop.Views.StorageCenterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="32" Spacing="14"><TextBlock Text="Storage Health Center" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="StorageCenterTitle"/><TextBlock Text="Read-only capacity, device health, temperature, wear, latency, filesystem, trends, and cleanup estimates. Nothing is deleted without a future explicit-selection workflow." TextWrapping="Wrap"/><Button Content="Analyze storage" Command="{Binding AnalyzeCommand}" AutomationProperties.AutomationId="AnalyzeStorageButton"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="Warnings and evidence" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Warnings}"/><TextBlock Text="Physical disks" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Disks}"/><TextBlock Text="Volumes and trends" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Volumes}"/><ItemsControl ItemsSource="{Binding Trends}"/><TextBlock Text="Cleanup preview" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Every category requires explicit selection. This page never deletes files."/><ItemsControl ItemsSource="{Binding Cleanup}"/></StackPanel></ScrollViewer></Page>
