<Page x:Class="WAID.Desktop.Views.NotificationCenterPage" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="14" MaxWidth="1150"><TextBlock Text="Notification Center" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="NotificationCenterTitle"/><TextBlock Text="Evidence-backed alerts are deduplicated and policy-controlled. Notifications provide guidance only and never execute repairs." TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Header="Search" Text="{Binding Search,Mode=TwoWay}" Width="220"/><ComboBox Header="Category" SelectedValue="{Binding Category,Mode=TwoWay}" SelectedValuePath="Content" Width="150"><ComboBoxItem Content="All"/><ComboBoxItem Content="Hardware"/><ComboBoxItem Content="Windows"/><ComboBoxItem Content="Drivers"/><ComboBoxItem Content="Security"/><ComboBoxItem Content="Performance"/><ComboBoxItem Content="Storage"/><ComboBoxItem Content="Network"/><ComboBoxItem Content="Updates"/></ComboBox><ComboBox Header="State" SelectedValue="{Binding State,Mode=TwoWay}" SelectedValuePath="Content" Width="140"><ComboBoxItem Content="All"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Acknowledged"/><ComboBoxItem Content="Snoozed"/><ComboBoxItem Content="Resolved"/></ComboBox><ComboBox Header="Minimum severity" SelectedValue="{Binding MinimumSeverity,Mode=TwoWay}" SelectedValuePath="Content" Width="160"><ComboBoxItem Content="Information"/><ComboBoxItem Content="Advisory"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Critical"/></ComboBox><Button Content="Apply filters" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshNotifications"/></StackPanel><TextBlock Text="Notification policy" Style="{StaticResource HeaderTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox Header="Cooldown minutes" Value="{Binding CooldownMinutes,Mode=TwoWay}" Minimum="5" Maximum="43200" Width="150"/><NumberBox Header="Quiet start hour" Value="{Binding QuietStartHour,Mode=TwoWay}" Minimum="0" Maximum="23" Width="140"/><NumberBox Header="Quiet end hour" Value="{Binding QuietEndHour,Mode=TwoWay}" Minimum="0" Maximum="23" Width="140"/><NumberBox Header="Escalate after repeats" Value="{Binding EscalateAfter,Mode=TwoWay}" Minimum="2" Maximum="100" Width="170"/><ComboBox Header="Delivery minimum" SelectedValue="{Binding DeliveryMinimumSeverity,Mode=TwoWay}" SelectedValuePath="Content" Width="150"><ComboBoxItem Content="Information"/><ComboBoxItem Content="Advisory"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Critical"/></ComboBox><CheckBox Content="In-app channel" IsChecked="{Binding InAppEnabled,Mode=TwoWay}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" AutomationProperties.AutomationId="SaveNotificationSettings"/></StackPanel><TextBlock Text="Notifications" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Alerts}" SelectionMode="None" AutomationProperties.AutomationId="NotificationList"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4"><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Width="80"/><TextBlock Text="{Binding Category}" Width="100"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding Occurrences}" AutomationProperties.Name="Occurrence count"/></StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding ActionLabel}"/><TextBlock Text="{Binding ActionTarget}"/><TextBlock Text="{Binding Evidence[0].SourceReference}" AutomationProperties.Name="Evidence source reference"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open related area" Click="OnOpenAction"/><Button Content="Acknowledge" Click="OnAcknowledge"/><Button Content="Snooze 4 hours" Click="OnSnooze"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></Page>
