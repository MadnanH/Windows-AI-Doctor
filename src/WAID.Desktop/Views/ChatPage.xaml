<Page x:Class="WAID.Desktop.Views.ChatPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="6"><TextBlock Text="AI Chat" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ChatTitle"/><TextBlock Text="Offline provider - grounded in saved WAID evidence. Chat cannot execute repairs." TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="ChatStatus"/></StackPanel>
    <ListView Grid.Row="1" ItemsSource="{Binding Messages}" AutomationProperties.AutomationId="ChatMessages"><ListView.ItemTemplate><DataTemplate><Border Padding="16" Margin="0,0,0,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="7"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Role}" FontWeight="SemiBold"/><TextBlock Text="{Binding Provider}" Opacity="0.7"/><TextBlock Text="{Binding Model}" Opacity="0.7"/></StackPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/><TextBlock Text="Supporting evidence" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="8" Margin="0,2" CornerRadius="12" Background="{ThemeResource AccentFillColorSecondaryBrush}"><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Source}" FontSize="12" Opacity="0.75"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Confidence:"/><TextBlock Text="{Binding Confidence}"/></StackPanel></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Question,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ask about this computer" AutomationProperties.AutomationId="ChatQuestion"/><Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" AutomationProperties.AutomationId="ChatSendButton"/></Grid>
  </Grid>
</Page>
