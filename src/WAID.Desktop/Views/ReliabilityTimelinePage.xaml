<Page x:Class="WAID.Desktop.Views.ReliabilityTimelinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><ScrollViewer><StackPanel Padding="28" Spacing="12" MaxWidth="1200"><TextBlock Text="Reliability Timeline" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ReliabilityTimelineTitle"/><TextBlock Text="A versioned projection of immutable WAID source records. Incident groups are possible associations based on time and subject—not proof of causation." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Rebuild timeline" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RebuildReliabilityTimeline"/><ComboBox Header="View" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode,Mode=TwoWay}" Width="130"/><ComboBox Header="Event type" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind,Mode=TwoWay}" Width="180"/><TextBox Header="Search" Text="{Binding Search,Mode=TwoWay}" Width="220"/><Button Content="Apply filters" Command="{Binding FilterCommand}"/><Button Content="Export JSON" Command="{Binding ExportCommand}"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ListView x:Name="TimelineList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent,Mode=TwoWay}" Visibility="{Binding TimelineVisibility}" SelectionMode="Single" AutomationProperties.AutomationId="ReliabilityTimelineView"><ListView.ItemTemplate><DataTemplate><Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12" Margin="0,3"><StackPanel><TextBlock><Run Text="{Binding OccurredAtUtc}"/><Run Text="  "/><Run Text="{Binding Kind}"/><Run Text="  "/><Run Text="{Binding Severity}"/></TextBlock><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock><Run Text="Source: "/><Run Text="{Binding Provenance.SourceType}"/><Run Text=" / "/><Run Text="{Binding Provenance.EvidenceReference}"/></TextBlock></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView><ListView x:Name="TableList" ItemsSource="{Binding Events}" Visibility="{Binding TableVisibility}" SelectionMode="Multiple" AutomationProperties.AutomationId="ReliabilityTableView"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OccurredAtUtc}"/><TextBlock Grid.Column="1" Text="{Binding Kind}"/><TextBlock Grid.Column="2" Text="{Binding Severity}"/><TextBlock Grid.Column="3" Text="{Binding Title}"/><TextBlock Grid.Column="4" Text="{Binding Provenance.EvidenceReference}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/><Button Content="Compare selected" Click="OnCompareClick"/></StackPanel><TextBlock Text="{Binding Comparison}" TextWrapping="Wrap"/><TextBlock Text="Selected event evidence" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding SelectedEvent.Provenance.EvidenceReference}"/><ItemsControl ItemsSource="{Binding SelectedEvent.Evidence}"/><TextBlock Text="Possible-association incidents" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident,Mode=TwoWay}" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding CorrelationLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding EventIds.Count}" AutomationProperties.Name="Incident event count"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Incident detail" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding SelectedIncident.CorrelationLabel}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding SelectedIncident.EventIds}"/></StackPanel></ScrollViewer></Grid></Page>
