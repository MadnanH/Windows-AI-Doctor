<Page x:Class="WAID.Desktop.Views.BootHealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100"><TextBlock Text="Boot Health" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="BootHealthTitle"/><TextBlock Text="Review startup folders, Run keys, services, scheduled tasks, shell extensions, login triggers, and startup applications. Analysis is read-only; critical Windows entries are protected." TextWrapping="Wrap"/><Button Content="Analyze startup" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AnalyzeStartupButton"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 <TextBlock Text="Recommendations and reversible previews" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Recommendations}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel Spacing="4"><TextBlock Text="{Binding EntryName}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Concern}"/><TextBlock Text="{Binding Impact}"/></StackPanel><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding ActionPreview}" TextWrapping="Wrap"/><TextBlock Text="{Binding RollbackPreview}" TextWrapping="Wrap" FontStyle="Italic"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Signal}"/><TextBlock Text="{Binding Value}"/><TextBlock Text="{Binding SourceReference}" Opacity="0.65"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Startup inventory" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Source}"/><TextBlock Text="{Binding Publisher}"/><TextBlock Text="{Binding MeasuredImpactMilliseconds}"/></StackPanel><TextBlock Text="{Binding Command}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceReference}" Opacity="0.65"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Recent boot measurements" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Boots}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding BootedAtUtc}"/><TextBlock Text="{Binding MainPathMilliseconds}"/><TextBlock Text="{Binding PostBootMilliseconds}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Entry history" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding History}"/></StackPanel></ScrollViewer>
</Page>
