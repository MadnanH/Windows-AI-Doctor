<Page x:Class="WAID.Desktop.Views.DriverHealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100">
    <TextBlock Text="Driver Health" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="DriverHealthTitle"/>
    <TextBlock Text="Evidence-based checks for device problems, signatures, load failures, compatibility, duplicates, and changes. WAID never downloads or changes drivers automatically." TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Analyze drivers" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="AnalyzeDriversButton"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter,Mode=TwoWay}" Header="Finding filter" Width="190" AutomationProperties.AutomationId="DriverFindingFilter"/></StackPanel>
    <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="Findings and evidence" Style="{StaticResource HeaderTextBlockStyle}"/>
    <ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Severity}"/><TextBlock Text="{Binding Confidence}"/></StackPanel><TextBlock Text="{Binding DeviceName}"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding RecommendedAction}" TextWrapping="Wrap" FontStyle="Italic"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Signal}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceReference}" Opacity="0.65"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Device tree" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><StackPanel><TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding DeviceClass}"/><TextBlock Text="{Binding Provider}"/><TextBlock Text="{Binding DriverVersion}"/></StackPanel><TextBlock Text="{Binding SignatureStatus}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Detected history" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding DeviceName}"/><TextBlock Text="{Binding ChangeType}"/><TextBlock Text="{Binding PreviousValue}"/><TextBlock Text="→"/><TextBlock Text="{Binding CurrentValue}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</Page>
