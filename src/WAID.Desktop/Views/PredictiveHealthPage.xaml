<Page x:Class="WAID.Desktop.Views.PredictiveHealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="14" MaxWidth="1100" HorizontalAlignment="Stretch"><TextBlock Text="Predictive Health" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Conservative, local trend analysis. Weak or inconsistent evidence is suppressed; no repair is ever started from this page." TextWrapping="Wrap"/><Button Content="Analyze saved health history" Command="{Binding AnalyzeCommand}" AutomationProperties.AutomationId="AnalyzePredictiveHealth" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ListView ItemsSource="{Binding Predictions}" SelectionMode="None" AutomationProperties.AutomationId="PredictiveHealthResults"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4"><StackPanel Spacing="5"><TextBlock Text="{Binding Kind}" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding MonitoringRecommendation}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="16"><TextBlock><Run Text="Model: "/><Run Text="{Binding ModelVersion}"/></TextBlock><TextBlock><Run Text="Horizon: "/><Run Text="{Binding Horizon}"/></TextBlock><TextBlock><Run Text="Validation: "/><Run Text="{Binding ValidationOutcome}"/></TextBlock></StackPanel><TextBlock Text="Risk and confidence ranges reflect statistical uncertainty and must be verified against source evidence." TextWrapping="Wrap" Opacity="0.75"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></Page>
