<Page x:Class="WAID.Desktop.Views.DiagnosisPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="1100"><StackPanel Spacing="8"><TextBlock Text="AI Diagnosis" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Offline correlation and plain-English root cause analysis. No diagnostic data leaves this PC." TextWrapping="Wrap"/></StackPanel><Button Content="Analyze latest scan" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="Likely root causes" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Report.RootCauses}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="20" Margin="0,0,0,12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="7"><TextBlock Text="{Binding LikelyCause}" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Confidence:"/><TextBlock Text="{Binding Confidence}"/><TextBlock Text="%"/><TextBlock Text="Severity:" Margin="10,0,0,0"/><TextBlock Text="{Binding Severity}"/><TextBlock Text="Priority:" Margin="10,0,0,0"/><TextBlock Text="{Binding RepairPriority}"/></StackPanel><TextBlock Text="{Binding ExplanationDetail.Calibration.Interpretation}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.Rationale}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.Impact}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.Urgency}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.NextStep}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.ChangeOverTime}" TextWrapping="Wrap" Opacity="0.7"/><TextBlock Text="Recommended repair" FontWeight="SemiBold"/><TextBlock Text="{Binding Recommendation.Title}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Evidence Viewer" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Report.Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Code}" Opacity="0.65"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
