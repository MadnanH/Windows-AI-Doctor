<Page x:Class="WAID.Desktop.Views.HealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="900"><TextBlock Text="Health Dashboard" Style="{StaticResource TitleTextBlockStyle}"/><Button Content="Refresh from latest scan" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Overall health:" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Report.Health.Overall}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="/100" FontSize="28" FontWeight="SemiBold"/></StackPanel><Grid ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Hardware"/><TextBlock Text="{Binding Report.Health.Hardware}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Windows"/><TextBlock Text="{Binding Report.Health.Windows}"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Drivers"/><TextBlock Text="{Binding Report.Health.Drivers}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Security"/><TextBlock Text="{Binding Report.Health.Security}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Performance"/><TextBlock Text="{Binding Report.Health.Performance}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Storage"/><TextBlock Text="{Binding Report.Health.Storage}"/></StackPanel><StackPanel Grid.Row="3"><TextBlock Text="Network"/><TextBlock Text="{Binding Report.Health.Network}"/></StackPanel></Grid><TextBlock Text="Correlated evidence" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Report.Correlations}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Correlation strength:"/><TextBlock Text="{Binding Strength}"/><TextBlock Text="%"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
