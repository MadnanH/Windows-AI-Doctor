<Page x:Class="WAID.Desktop.Views.LiveMonitoringPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="14" MaxWidth="1100"><TextBlock Text="Live Monitoring" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="LiveMonitoringTitle"/><TextBlock Text="Low-overhead local sampling runs only while WAID is active. It never performs repairs. Disable monitoring at any time to stop all collection." TextWrapping="Wrap"/><ToggleSwitch Header="Enable live monitoring" IsOn="{Binding Enabled,Mode=TwoWay}" AutomationProperties.AutomationId="MonitoringEnabled"/><StackPanel Orientation="Horizontal" Spacing="14"><CheckBox Content="CPU" IsChecked="{Binding CpuEnabled,Mode=TwoWay}"/><CheckBox Content="Memory" IsChecked="{Binding MemoryEnabled,Mode=TwoWay}"/><CheckBox Content="Storage free space" IsChecked="{Binding StorageEnabled,Mode=TwoWay}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><NumberBox Header="Base interval (seconds)" Value="{Binding IntervalSeconds,Mode=TwoWay}" Minimum="15" Maximum="3600" Width="180"/><NumberBox Header="Maximum adaptive interval" Value="{Binding MaximumIntervalSeconds,Mode=TwoWay}" Minimum="15" Maximum="14400" Width="210"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Start" Command="{Binding StartCommand}" AutomationProperties.AutomationId="StartLiveMonitoring"/><Button Content="Pause" Command="{Binding PauseCommand}"/><Button Content="Resume" Command="{Binding ResumeCommand}"/><Button Content="Stop and disable" Command="{Binding StopCommand}" AutomationProperties.AutomationId="StopLiveMonitoring"/><Button Content="Refresh history" Command="{Binding RefreshCommand}"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Resource budget" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding ResourceUsage}" TextWrapping="Wrap"/><TextBlock Text="Active threshold alerts" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Alerts}" DisplayMemberPath="Message"/><TextBlock Text="Recent samples" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Samples}" SelectionMode="None" AutomationProperties.AutomationId="LiveMonitoringSamples"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CapturedAtUtc}" Width="190"/><TextBlock Text="{Binding SignalId}" Width="100"/><TextBlock Text="{Binding Value}" Width="80"/><TextBlock Text="{Binding Unit}" Width="90"/><TextBlock Text="{Binding Severity}" Width="100"/><TextBlock Text="{Binding Source}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Collection gaps and failures" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Gaps}" DisplayMemberPath="Detail"/><ItemsControl ItemsSource="{Binding Failures}" DisplayMemberPath="SafeMessage"/><TextBlock Text="Privacy" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="WAID stores numeric CPU, memory, and free-space measurements with timestamps and provider names in local SQLite storage. It does not inspect file contents, browser data, credentials, product keys, or personal documents. Retention is bounded to 30 days and 50,000 samples by default." TextWrapping="Wrap"/></StackPanel></ScrollViewer></Page>
