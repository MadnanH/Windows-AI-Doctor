<Page x:Class="WAID.Desktop.Views.SecurityCenterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="32" Spacing="14"><TextBlock Text="Windows Security Posture" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="SecurityCenterTitle"/><TextBlock Text="Transparent checks that complement—not replace—Windows Security. WAID never weakens controls or bypasses policy." TextWrapping="Wrap"/><Button Content="Analyze security posture" Command="{Binding AnalyzeCommand}" AutomationProperties.AutomationId="AnalyzeSecurityButton"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="Controls and policy sources" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Controls}"/><TextBlock Text="Findings and remediation previews" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Findings}"/></StackPanel></ScrollViewer></Page>
