<Page x:Class="WAID.Desktop.Views.NetworkHealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="14" MaxWidth="1100"><TextBlock Text="Network Health" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="NetworkHealthTitle"/><TextBlock Text="Inspect the local stack, adapter, LAN gateway, DNS, proxy, VPN, Wi-Fi, firewall, and application path. Optional active probes contact only endpoints you enter." TextWrapping="Wrap"/>
 <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><TextBox Header="Optional DNS name" PlaceholderText="Leave blank to skip DNS probe" Text="{Binding DnsName,Mode=TwoWay}" AutomationProperties.AutomationId="NetworkDnsName"/><TextBox Grid.Column="1" Header="Optional HTTP/HTTPS endpoint" PlaceholderText="Leave blank to avoid internet requests" Text="{Binding HttpEndpoint,Mode=TwoWay}" AutomationProperties.AutomationId="NetworkHttpEndpoint"/></Grid>
 <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Run diagnostics" Command="{Binding RunCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RunNetworkDiagnostics"/><Button Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelNetworkDiagnostics"/><Button Content="Export JSON" Command="{Binding ExportCommand}" AutomationProperties.AutomationId="ExportNetworkDiagnostics"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="NetworkStatus"/>
 <TextBlock Text="Topology summary" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Topology}"/>
 <TextBlock Text="Test sequence" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Tests}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Layer}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Status}"/></StackPanel><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceReference}" Opacity="0.65"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Evidence-backed findings" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Layer}" FontWeight="SemiBold"/><TextBlock Text="{Binding Severity}"/><TextBlock Text="{Binding Confidence}"/></StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><TextBlock Text="Any reset remains behind WAID's separate explicit-approval repair workflow." Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</Page>
