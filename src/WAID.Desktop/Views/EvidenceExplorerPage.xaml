<Page x:Class="WAID.Desktop.Views.EvidenceExplorerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100"><TextBlock Text="Incident &amp; Evidence Explorer" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="EvidenceExplorerTitle"/><TextBlock Text="Normalized evidence and traceable candidate associations. Connections indicate correlation, never proven causation." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Refresh evidence" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RefreshEvidenceGraph"/><ComboBox Header="Domain filter" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter,Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="EvidenceDomainFilter"/><ToggleSwitch Header="Graph mode" IsOn="{Binding GraphMode,Mode=TwoWay}" OnContent="Graph relationship list" OffContent="Evidence list" AutomationProperties.AutomationId="EvidenceViewMode"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="EvidenceExplorerStatus"/><TextBlock Text="Evidence nodes" Style="{StaticResource HeaderTextBlockStyle}" Visibility="{Binding NodeListVisibility}"/><ItemsControl ItemsSource="{Binding Nodes}" Visibility="{Binding NodeListVisibility}" AutomationProperties.AutomationId="EvidenceNodeList"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Domain}" FontWeight="SemiBold"/><TextBlock Text="{Binding Code}"/><TextBlock Text="{Binding Freshness}"/></StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding LastObservedAtUtc}" Opacity="0.7"/><TextBlock Text="{Binding DuplicateCount}" AutomationProperties.Name="Duplicate count"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Candidate relationships" Style="{StaticResource HeaderTextBlockStyle}" Visibility="{Binding GraphListVisibility}"/><ItemsControl ItemsSource="{Binding Relationships}" Visibility="{Binding GraphListVisibility}" AutomationProperties.AutomationId="EvidenceRelationshipList"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,7" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="3"><TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/><TextBlock Text="{Binding Rationale}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Confidence"/><TextBlock Text="{Binding Confidence}"/><TextBlock Text="{Binding StrategyVersion}"/></StackPanel><TextBlock Text="Association only — not a causal claim."/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Page>