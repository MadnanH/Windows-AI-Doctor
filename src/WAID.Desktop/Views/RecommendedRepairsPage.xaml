<Page x:Class="WAID.Desktop.Views.RecommendedRepairsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="18" MaxWidth="1000"><TextBlock Text="Recommended Repairs" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Recommendations come from the latest offline diagnosis. Every repair still requires explicit confirmation." TextWrapping="Wrap"/><Button Content="Refresh recommendations" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding RecommendedRepairs}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="18" Margin="0,0,0,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{Binding LikelyCause}" FontWeight="SemiBold"/><TextBlock Text="{Binding Recommendation.Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.Rationale}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.Calibration.Interpretation}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExplanationDetail.NextStep}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Confidence:"/><TextBlock Text="{Binding Confidence}"/><TextBlock Text="%"/></StackPanel></StackPanel><Button Grid.Column="1" Content="Review and run" Click="OnRepairClick" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
