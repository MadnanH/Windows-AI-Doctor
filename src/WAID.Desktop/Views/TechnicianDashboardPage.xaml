<Page x:Class="WAID.Desktop.Views.TechnicianDashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="12" MaxWidth="1100"><TextBlock Text="Technician Dashboard" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="TechnicianDashboardTitle"/><TextBlock Text="Professional presentation is a local display profile, not a security role. Repairs still require their normal explicit approvals." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox Header="Presentation profile" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile,Mode=TwoWay}" Width="190" AutomationProperties.AutomationId="TechnicianProfile"/><ComboBox Header="Layout" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout,Mode=TwoWay}" Width="160" AutomationProperties.AutomationId="TechnicianLayout"/><TextBox Header="Saved filter" Text="{Binding Filter,Mode=TwoWay}" Width="240" AutomationProperties.AutomationId="TechnicianSavedFilter"/><Button Content="Save view" Command="{Binding SavePreferencesCommand}" VerticalAlignment="Bottom"/><Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RefreshTechnicianDashboard"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Active incidents" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Incidents}" AutomationProperties.AutomationId="TechnicianIncidents"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Severity}"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Case notes" Style="{StaticResource HeaderTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Header="Case ID" Text="{Binding CaseId,Mode=TwoWay}" Width="160"/><TextBox Header="Title" Text="{Binding CaseTitle,Mode=TwoWay}" Width="240"/><TextBox Header="Notes" Text="{Binding Notes,Mode=TwoWay}" Width="420"/><Button Content="Save case" Command="{Binding SaveCaseCommand}" VerticalAlignment="Bottom"/></StackPanel><ItemsControl ItemsSource="{Binding Cases}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding CaseId}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Repair queue and outcomes" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Repairs}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Stage}"/><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Evidence and recent changes" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Reports and export shortcuts" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Use History for redacted repair-audit export and Monitoring &amp; Reports for diagnostic packages." TextWrapping="Wrap"/></StackPanel></ScrollViewer></Page>