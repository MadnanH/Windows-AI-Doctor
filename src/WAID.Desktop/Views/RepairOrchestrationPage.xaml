<Page x:Class="WAID.Desktop.Views.RepairOrchestrationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="14" MaxWidth="1100"><TextBlock Text="Repair Lifecycle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="RepairLifecycleTitle"/><TextBlock Text="Every repair is assessed, simulated, approved, prepared, executed, validated, and committed or rolled back. Interrupted execution is never repeated automatically." TextWrapping="Wrap"/><ComboBox Header="Repair definition" ItemsSource="{Binding Repairs}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedRepairId,Mode=TwoWay}" Width="420" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Assess and simulate" Command="{Binding SimulateCommand}" AutomationProperties.AutomationId="SimulateRepairButton"/><CheckBox Content="I approve this repair plan" IsChecked="{Binding Approved,Mode=TwoWay}"/><CheckBox Content="I acknowledge medium/high risk" IsChecked="{Binding RiskAcknowledged,Mode=TwoWay}"/><Button Content="Execute approved plan" Command="{Binding ExecuteCommand}" AutomationProperties.AutomationId="ExecuteRepairLifecycleButton"/><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Content="Check interrupted work" Command="{Binding RecoverCommand}"/><Button Content="Refresh history" Command="{Binding RefreshCommand}"/></StackPanel><ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Risk and safeguards" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding Risk}"/><TextBlock Text="{Binding Safeguards}" TextWrapping="Wrap"/><TextBlock Text="{Binding Backup}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Validation and outcome" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding Validation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Restart}"/><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"/></StackPanel></Grid><TextBlock Text="Dry-run preview" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding SimulationMetadata}" TextWrapping="Wrap"/><TextBlock Text="{Binding Duration}"/><TextBlock Text="{Binding PredictedRestart}"/><TextBlock Text="{Binding RollbackReadiness}"/><TextBlock Text="{Binding SimulationWarnings}" TextWrapping="Wrap"/><ListView ItemsSource="{Binding Effects}" SelectionMode="None" AutomationProperties.AutomationId="RepairDryRunEffects"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}"/><TextBlock Grid.Column="1" Text="{Binding Target}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Before}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding After}" TextWrapping="Wrap"/><TextBlock Grid.Column="4" Text="{Binding Certainty}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Lifecycle steps" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Steps}" SelectionMode="None" AutomationProperties.AutomationId="RepairLifecycleSteps"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Order}" Width="30"/><TextBlock Text="{Binding Title}" Width="150"/><TextBlock Text="{Binding Status}" Width="90"/><TextBlock Text="{Binding Detail}" Width="650" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Recent lifecycle reports" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding RepairId}" Width="160"/><TextBlock Text="{Binding Stage}" Width="130"/><TextBlock Text="{Binding UpdatedAtUtc}" Width="190"/><TextBlock Text="{Binding Outcome}" Width="520" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Page>
