<Page x:Class="WAID.Desktop.Views.RepairOrchestrationPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer AutomationProperties.AutomationId="RepairWorkflowScreen">
  <StackPanel Padding="28" Spacing="14" MaxWidth="1100">
   <TextBlock Text="Repair workflow" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="RepairLifecycleTitle" AutomationProperties.HeadingLevel="Level1"/>
   <TextBlock Text="No repair runs without your explicit approval. Your reviewed plan is saved and can resume safely after an application restart." TextWrapping="Wrap"/>
   <Border Padding="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <StackPanel Spacing="6">
     <TextBlock Text="{Binding CurrentScreen}" Style="{StaticResource HeaderTextBlockStyle}" AutomationProperties.Name="Current workflow screen"/>
     <TextBlock Text="{Binding CurrentAction}" TextWrapping="Wrap" AutomationProperties.AutomationId="RepairCurrentAction" AutomationProperties.Name="Exact current repair action" AutomationProperties.LiveSetting="Assertive"/>
     <ToggleSwitch Header="Explanation detail" OffContent="Plain English" OnContent="Technical details" IsOn="{Binding ShowTechnical,Mode=TwoWay}" AutomationProperties.AutomationId="RepairTechnicalView"/>
     <TextBlock Text="{Binding DisplayedSummary}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>

   <Expander Header="1. Review repair plan" IsExpanded="True">
    <StackPanel Spacing="8">
     <ComboBox Header="Repair definition" ItemsSource="{Binding Repairs}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedRepairId,Mode=TwoWay}" MaxWidth="520" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RepairDefinition" AutomationProperties.HelpText="Choose the repair to review. This does not make changes."/>
     <Button Content="Assess and simulate" Command="{Binding SimulateCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SimulateRepairButton"/>
    </StackPanel>
   </Expander>

   <Expander Header="2. Evidence and simulation" IsExpanded="True">
    <StackPanel Spacing="6">
     <TextBlock Text="{Binding SimulationMetadata}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Duration}"/><TextBlock Text="{Binding PredictedRestart}"/><TextBlock Text="{Binding RollbackReadiness}"/>
     <TextBlock Text="{Binding SimulationWarnings}" TextWrapping="Wrap"/>
     <ListView ItemsSource="{Binding Effects}" SelectionMode="None" AutomationProperties.AutomationId="RepairDryRunEffects" AutomationProperties.Name="Predicted repair effects">
      <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Before}" TextWrapping="Wrap"/><TextBlock Text="{Binding After}" TextWrapping="Wrap"/><TextBlock Text="{Binding Certainty}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </StackPanel>
   </Expander>

   <Expander Header="3. Safety and approval" IsExpanded="True">
    <StackPanel Spacing="7">
     <TextBlock Text="{Binding SafetyScore}"/><TextBlock Text="{Binding ApprovalRequirement}"/><TextBlock Text="{Binding PolicyDecision}" TextWrapping="Wrap"/><TextBlock Text="{Binding SafetyExceptions}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Safeguards}" TextWrapping="Wrap"/><TextBlock Text="{Binding Backup}" TextWrapping="Wrap"/>
     <CheckBox Content="I approve this specific repair plan" IsChecked="{Binding Approved,Mode=TwoWay}" AutomationProperties.AutomationId="RepairApprovalCheck"/>
     <CheckBox Content="I understand and accept the stated medium or high risk" IsChecked="{Binding RiskAcknowledged,Mode=TwoWay}" AutomationProperties.AutomationId="RepairRiskAcknowledgement"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Execute approved plan" Command="{Binding ExecuteCommand}" AutomationProperties.AutomationId="ExecuteRepairLifecycleButton"/>
      <Button Content="Cancel current action" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelRepairLifecycle"/>
     </StackPanel>
    </StackPanel>
   </Expander>

   <Expander Header="4. Progress, restart, and validation" IsExpanded="True">
    <StackPanel Spacing="7">
     <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" AutomationProperties.Name="Repair workflow progress"/>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="RepairWorkflowStatus" AutomationProperties.LiveSetting="Assertive"/>
     <TextBlock Text="{Binding Restart}"/><TextBlock Text="{Binding Validation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"/>
     <ListView ItemsSource="{Binding Steps}" SelectionMode="None" AutomationProperties.AutomationId="RepairLifecycleSteps"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel>
   </Expander>

   <Expander Header="5. Rollback and recovery">
    <StackPanel Spacing="8">
     <TextBlock Text="Rollback requires a current, protected, integrity-validated artifact and separate explicit confirmation." TextWrapping="Wrap"/>
     <CheckBox Content="I explicitly confirm rollback of the selected artifact" IsChecked="{Binding RollbackConfirmed,Mode=TwoWay}" AutomationProperties.AutomationId="RollbackApprovalCheck"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Rollback selected artifact" Command="{Binding RollbackArtifactCommand}" AutomationProperties.AutomationId="RollbackRecoveryArtifactButton"/>
      <Button Content="Delete expired artifacts" Command="{Binding CleanupArtifactsCommand}" AutomationProperties.AutomationId="CleanupRecoveryArtifactsButton"/>
      <Button Content="Check interrupted work" Command="{Binding RecoverCommand}" AutomationProperties.AutomationId="RecoverRepairLifecycle"/>
     </StackPanel>
     <ListView ItemsSource="{Binding RecoveryArtifacts}" SelectedItem="{Binding SelectedArtifact,Mode=TwoWay}" SelectionMode="Single" AutomationProperties.AutomationId="RecoveryArtifactsList"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Text="{Binding Protection}"/><TextBlock Text="{Binding Capability}"/><TextBlock Text="{Binding ValidationDetail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel>
   </Expander>

   <Expander Header="6. Repair reports">
    <StackPanel Spacing="8">
     <Button Content="Refresh reports" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RefreshRepairLifecycle"/>
     <ItemsControl ItemsSource="{Binding History}" AutomationProperties.AutomationId="RepairLifecycleReports"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Stage}"/><TextBlock Text="{Binding UpdatedAtUtc}"/><TextBlock Text="{Binding Outcome}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</Page>