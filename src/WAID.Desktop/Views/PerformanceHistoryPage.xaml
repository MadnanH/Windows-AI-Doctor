<Page x:Class="WAID.Desktop.Views.PerformanceHistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="12" MaxWidth="1150"><TextBlock Text="Performance History" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="PerformanceHistoryTitle"/><TextBlock Text="Local trends for CPU, memory, disk, network, temperature, battery, and responsiveness. Missing measurements are shown as unavailable rather than healthy." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Collect now" Command="{Binding CollectCommand}" AutomationProperties.AutomationId="CollectPerformanceMetrics"/><ComboBox Header="Metric" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind,Mode=TwoWay}" Width="210"/><ComboBox Header="Resolution" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution,Mode=TwoWay}" Width="130"/><NumberBox Header="Period days" Value="{Binding Days,Mode=TwoWay}" Minimum="1" Maximum="365" Width="120"/><Button Content="Refresh chart" Command="{Binding RefreshCommand}"/><Button Content="Compare periods" Command="{Binding CompareCommand}"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Current metric cards" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12" Margin="4" Width="250"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="20"/><TextBlock Text="{Binding Quality}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Accessible chart summary" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding AccessibleSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="PerformanceChartSummary"/><ListView ItemsSource="{Binding Points}" SelectionMode="None" AutomationProperties.AutomationId="PerformanceTrendChart"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PeriodStartUtc}"/><TextBlock Grid.Column="1" Text="{Binding Minimum}"/><TextBlock Grid.Column="2" Text="{Binding Average}"/><TextBlock Grid.Column="3" Text="{Binding Maximum}"/><TextBlock Grid.Column="4" Text="{Binding CoveragePercent}"/><TextBlock Grid.Column="5" Text="{Binding Quality}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Sustained changes" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Changes}" DisplayMemberPath="Explanation"/><TextBlock Text="Period comparison" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="{Binding Comparison}" TextWrapping="Wrap"/><TextBlock Text="Charts use stored versioned rollups and bounded downsampling. Comparisons are descriptive and do not establish causation." TextWrapping="Wrap" Opacity="0.75"/></StackPanel></ScrollViewer></Page>
