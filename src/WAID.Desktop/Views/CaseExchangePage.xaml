<Page x:Class="WAID.Desktop.Views.CaseExchangePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="1000">
    <TextBlock Text="Diagnostic Case Exchange" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="CaseExchangeTitle"/>
    <TextBlock Text="Create encrypted, redacted offline packages for technician review. Imported packages are untrusted, temporary, and can never change this computer." TextWrapping="Wrap"/>
    <InfoBar IsOpen="True" Severity="Warning" Title="Privacy and safety" Message="Full dump contents, secrets, browser data, personal files, product keys, and unnecessary serial numbers are always excluded. Share the package password through a separate channel."/>
    <StackPanel Spacing="8"><TextBlock Text="1. Choose package content" Style="{StaticResource HeaderTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox Content="Scans, findings, and crash metadata" IsChecked="{Binding IncludeScans,Mode=TwoWay}"/><CheckBox Content="Diagnosis and report" IsChecked="{Binding IncludeDiagnosis,Mode=TwoWay}"/><CheckBox Content="Timeline" IsChecked="{Binding IncludeTimeline,Mode=TwoWay}"/><CheckBox Content="Repair history" IsChecked="{Binding IncludeRepairHistory,Mode=TwoWay}"/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox Content="Sanitized logs" IsChecked="{Binding IncludeLogs,Mode=TwoWay}"/><CheckBox Content="Non-sensitive system summary" IsChecked="{Binding IncludeSystemSummary,Mode=TwoWay}"/><CheckBox Content="Case notes" IsChecked="{Binding IncludeNotes,Mode=TwoWay}"/><CheckBox Content="Maximum redaction" IsChecked="{Binding MaximumRedaction,Mode=TwoWay}"/></StackPanel>
      <TextBox Header="Case notes (optional, redacted)" Text="{Binding Notes,Mode=TwoWay}" AcceptsReturn="True" MaxLength="4000" Height="100" AutomationProperties.AutomationId="CaseNotes"/>
    </StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="2. Preview redaction" Style="{StaticResource HeaderTextBlockStyle}"/><Button Content="Generate content and redaction preview" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="PreviewCasePackage"/><TextBlock Text="{Binding Preview}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="3. Encrypt and export" Style="{StaticResource HeaderTextBlockStyle}"/><PasswordBox Header="Package password (12-256 characters)" PasswordChanged="OnPasswordChanged" MaxLength="256" AutomationProperties.AutomationId="CasePassword"/><Button Content="Export encrypted package" Command="{Binding ExportCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ExportCasePackage"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="4. Validate and review a package" Style="{StaticResource HeaderTextBlockStyle}"/><TextBox Header="Full path to .waidcase package" Text="{Binding ImportPath,Mode=TwoWay}" AutomationProperties.AutomationId="ImportCasePath"/><TextBlock Text="Use the password field above, then validate. Integrity or compatibility failures block all content." TextWrapping="Wrap"/><Button Content="Validate and open in review mode" Command="{Binding ImportCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportCasePackage"/><InfoBar IsOpen="True" Severity="Warning" Title="Review mode" Message="{Binding ReviewBanner}" AutomationProperties.LiveSetting="Assertive"/><ItemsControl ItemsSource="{Binding ReviewItems}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Name}" Margin="0,4"><TextBox Text="{Binding Preview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="320" FontFamily="Consolas"/></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CaseExchangeStatus"/>
  </StackPanel></ScrollViewer>
</Page>
