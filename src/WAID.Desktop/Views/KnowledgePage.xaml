<Page x:Class="WAID.Desktop.Views.KnowledgePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1050"><TextBlock Text="Offline Knowledge" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="KnowledgeTitle"/><TextBlock Text="Curated Windows guidance ranked locally by relevance, saved evidence, compatibility, freshness, and trust." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBox Width="520" Header="Search" Text="{Binding Query,Mode=TwoWay}" PlaceholderText="Error code, symptom, or Windows feature" AutomationProperties.AutomationId="KnowledgeQuery"/><Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="KnowledgeSearch"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="KnowledgeStatus"/><ItemsControl ItemsSource="{Binding Results}" AutomationProperties.AutomationId="KnowledgeResults"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="16" Margin="0,0,0,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="5"><TextBlock Text="{Binding Article.Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ContentLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Article.Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Applicability}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Source:"/><TextBlock Text="{Binding Article.Source}"/><TextBlock Text="License:"/><TextBlock Text="{Binding Article.License}"/></StackPanel><TextBlock Text="{Binding Article.Body}" TextWrapping="Wrap"/><TextBlock Text="{Binding TrustedRepairGuidance}" TextWrapping="Wrap"/><TextBlock Text="Linked finding codes are included in the relevance score when present." Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Page>