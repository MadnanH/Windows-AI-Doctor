<Page x:Class="WAID.Desktop.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="18" MaxWidth="1000"><TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="Scan history" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Scans}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{Binding StartedAtUtc}"/><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="Findings:"/><TextBlock Text="{Binding FindingCount}"/></StackPanel><TextBlock Text="{Binding Id}" Opacity="0.6"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Repair history" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Repairs}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding CreatedAtUtc}" Opacity="0.6"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
</Page>
