<Page x:Class="WAID.Desktop.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1050">
  <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="HistoryTitle" AutomationProperties.HeadingLevel="Level1"/>
  <TextBlock Text="Repair outcomes are derived only from recorded validation. Statistics describe past observations and never authorize or create repairs." TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
   <TextBox Header="Repair ID filter" Text="{Binding RepairFilter,Mode=TwoWay}" Width="260" AutomationProperties.AutomationId="RepairHistoryFilter"/>
   <ComboBox Header="Outcome" ItemsSource="{Binding OutcomeFilters}" SelectedItem="{Binding OutcomeFilter,Mode=TwoWay}" Width="190" AutomationProperties.AutomationId="RepairOutcomeFilter"/>
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="RefreshHistory"/>
   <Button Content="Export redacted audit" Command="{Binding ExportCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="ExportRepairAudit"/>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="Repair outcome statistics" Style="{StaticResource HeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
  <ItemsControl ItemsSource="{Binding OutcomeAggregates}" AutomationProperties.AutomationId="RepairOutcomeAggregates"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Interpretation}" TextWrapping="Wrap"/><TextBlock Text="{Binding ValidatedSuccessRate}"/><TextBlock Text="{Binding AggregateVersion}" Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Immutable repair decision chain" Style="{StaticResource HeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
  <ItemsControl ItemsSource="{Binding RepairAudit}" AutomationProperties.AutomationId="RepairAuditChain"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel Spacing="3"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}"/><TextBlock Text="{Binding Outcome}"/></StackPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Actor}"/><TextBlock Text="{Binding OccurredAtUtc}" Opacity="0.7"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Repair transaction details and rollback" Style="{StaticResource HeaderTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
  <ItemsControl ItemsSource="{Binding Repairs}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{Binding RepairId}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/><TextBlock Text="{Binding BackupLocation}" TextWrapping="Wrap"/><TextBlock Text="{Binding RestorePointDescription}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding CreatedAtUtc}" Opacity="0.6"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Scan history" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Scans}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StartedAtUtc}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Latest diagnosis explanations" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Explanations}" AutomationProperties.AutomationId="DiagnosisExplanationTimeline"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Rationale}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</Page>