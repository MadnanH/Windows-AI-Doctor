<Page x:Class="WAID.Desktop.Views.UpdateHealthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="32" Spacing="16" MaxWidth="1100"><TextBlock Text="Update Health" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="UpdateHealthTitle"/><TextBlock Text="Diagnose Windows Update history, servicing, policy, storage, network, required services, and pending restart state. Repairs are simulated and require explicit approval." TextWrapping="Wrap"/><Button Content="Analyze updates" Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AnalyzeUpdatesButton"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding RestartStatus}" FontWeight="SemiBold"/>
<TextBlock Text="Diagnosed causes" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Diagnoses}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Cause}"/><TextBlock Text="{Binding Severity}"/><TextBlock Text="{Binding Confidence}"/></StackPanel><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Evidence}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Signal}"/><TextBlock Text="{Binding Value}"/><TextBlock Text="{Binding SourceReference}" Opacity="0.65"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Failure timeline" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding Attempts}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,0,0,5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding OccurredAtUtc}"/><TextBlock Text="{Binding KnowledgeBaseId}"/><TextBlock Text="{Binding ErrorCode}"/><TextBlock Text="{Binding State}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Repair simulation plan" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Nothing below runs automatically. No update removal is included."/><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Administrator:"/><TextBlock Text="{Binding RequiresAdministrator}"/><TextBlock Text="Restart:"/><TextBlock Text="{Binding RequiresRestart}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Page>
