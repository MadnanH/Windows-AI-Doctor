<Page x:Class="WAID.Desktop.Views.DigitalTwinPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer><StackPanel Padding="28" Spacing="12" MaxWidth="1150"><TextBlock Text="System Snapshots" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="DigitalTwinTitle"/><TextBlock Text="Privacy-safe, integrity-checked snapshots contain structured system state only. They exclude secrets, serial numbers, personal file inventories, browser data, and document contents." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox Header="Purpose" ItemsSource="{Binding Purposes}" SelectedItem="{Binding Purpose,Mode=TwoWay}" Width="150"/><CheckBox Content="Pin against retention" IsChecked="{Binding IsPinned,Mode=TwoWay}" VerticalAlignment="Bottom"/><Button Content="Capture snapshot" Command="{Binding CaptureCommand}" AutomationProperties.AutomationId="CaptureDigitalTwin"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Compare snapshots" Style="{StaticResource HeaderTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox Header="Before" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Before,Mode=TwoWay}" DisplayMemberPath="CapturedAtUtc" Width="230"/><ComboBox Header="After" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding After,Mode=TwoWay}" DisplayMemberPath="CapturedAtUtc" Width="230"/><Button Content="Compare" Command="{Binding CompareCommand}"/><Button Content="Export selected result" Command="{Binding ExportCommand}"/></StackPanel><TextBlock Text="Risk highlights" Style="{StaticResource HeaderTextBlockStyle}"/><ItemsControl ItemsSource="{Binding RiskHighlights}"/><TextBlock Text="Component changes" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Changes}" SelectionMode="None" AutomationProperties.AutomationId="DigitalTwinChanges"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Component}"/><TextBlock Grid.Column="1" Text="{Binding Key}"/><TextBlock Grid.Column="2" Text="{Binding Kind}"/><TextBlock Grid.Column="3" Text="{Binding Risk}"/><TextBlock Grid.Column="4" Text="{Binding Explanation}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="Snapshot history" Style="{StaticResource HeaderTextBlockStyle}"/><ListView ItemsSource="{Binding Snapshots}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding CapturedAtUtc}" Width="200"/><TextBlock Text="{Binding Purpose}" Width="100"/><TextBlock Text="{Binding IsPinned}" Width="60" AutomationProperties.Name="Pinned"/><TextBlock Text="{Binding IntegritySha256}" Width="400"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></Page>
