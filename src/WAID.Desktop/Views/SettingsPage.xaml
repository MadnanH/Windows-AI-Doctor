<Page x:Class="WAID.Desktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/><ToggleSwitch Header="Scan when WAID starts" IsOn="{Binding RunScansAtStartup,Mode=TwoWay}"/><ToggleSwitch Header="Enable local AI analysis" IsOn="{Binding EnableAiAnalysis,Mode=TwoWay}"/><ToggleSwitch Header="Share anonymous diagnostics" IsOn="{Binding AllowTelemetry,Mode=TwoWay}"/><ComboBox Header="App theme" SelectedValue="{Binding Theme,Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Status}"/></StackPanel></ScrollViewer>
</Page>
