<Page x:Class="WAID.Desktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
  <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
  <ToggleSwitch Header="Scan when WAID starts" IsOn="{Binding RunScansAtStartup,Mode=TwoWay}"/>
  <ToggleSwitch Header="Enable local AI analysis" IsOn="{Binding EnableAiAnalysis,Mode=TwoWay}"/>
  <ToggleSwitch Header="Share anonymous diagnostics" IsOn="{Binding AllowTelemetry,Mode=TwoWay}"/>
  <ComboBox Header="App theme" SelectedValue="{Binding Theme,Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
  <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
  <TextBlock Text="Database health and recovery" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
  <InfoBar IsOpen="True" Title="{Binding DatabaseState}" Message="{Binding DatabaseDetail}" IsClosable="False"/>
  <TextBlock Text="{Binding MigrationStatus}" TextWrapping="Wrap"/>
  <TextBlock Text="Backup folder" FontWeight="SemiBold"/><TextBlock Text="{Binding BackupLocation}" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Refresh database health" Command="{Binding RefreshDatabaseCommand}" AutomationProperties.AutomationId="RefreshDatabaseHealth"/><Button Content="Create verified backup" Command="{Binding BackupDatabaseCommand}" AutomationProperties.AutomationId="BackupDatabase"/></StackPanel>
  <TextBox Header="Verified backup file to restore" Text="{Binding RestorePath,Mode=TwoWay}" PlaceholderText="Enter the full path to a WAID database backup"/>
  <CheckBox Content="I understand this replaces local WAID history and settings" IsChecked="{Binding RestoreApproved,Mode=TwoWay}"/>
  <Button Content="Restore verified backup" Command="{Binding RestoreDatabaseCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="RestoreDatabase"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
</Page>
