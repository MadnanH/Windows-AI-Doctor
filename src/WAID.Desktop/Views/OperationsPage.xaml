<Page x:Class="WAID.Desktop.Views.OperationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="32" Spacing="24" MaxWidth="1000">
    <TextBlock Text="Continuous Monitoring and Reports" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    <StackPanel Spacing="8"><TextBlock Text="Live Monitoring" Style="{StaticResource HeaderTextBlockStyle}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Overall health"/><TextBlock Text="{Binding Snapshot.Health.Overall}"/><TextBlock Text="State"/><TextBlock Text="{Binding MonitoringState}"/><TextBlock Text="Last scan"/><TextBlock Text="{Binding LastScanTime}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="CPU"/><TextBlock Text="{Binding CpuStatus}"/><TextBlock Text="RAM"/><TextBlock Text="{Binding RamStatus}"/><TextBlock Text="Disk"/><TextBlock Text="{Binding DiskStatus}"/><TextBlock Text="Storage"/><TextBlock Text="{Binding StorageStatus}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Security"/><TextBlock Text="{Binding SecurityStatus}"/><TextBlock Text="Drivers"/><TextBlock Text="{Binding DriverStatus}"/><TextBlock Text="Updates"/><TextBlock Text="{Binding UpdateStatus}"/><TextBlock Text="Network"/><TextBlock Text="{Binding NetworkStatus}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox Header="Refresh minutes" Value="{Binding RefreshMinutes,Mode=TwoWay}" Minimum="1" Maximum="1440" Width="130"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/><Button Content="Start monitoring" Command="{Binding StartCommand}"/><Button Content="Stop monitoring" Command="{Binding StopCommand}"/><CheckBox Content="Launch at Windows sign-in" IsChecked="{Binding LaunchAtStartup,Mode=TwoWay}"/></StackPanel><TextBlock Text="Active alerts" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ActiveAlerts}" DisplayMemberPath="Title"/><TextBlock Text="Recent critical events" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding RecentCriticalEvents}" DisplayMemberPath="Title"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Scheduled Scans" Style="{StaticResource HeaderTextBlockStyle}" AutomationProperties.AutomationId="ScheduledScansTitle"/><TextBlock Text="Schedules run read-only diagnostics only. They never execute repairs." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><CheckBox Content="Enabled" IsChecked="{Binding ScheduleEnabled,Mode=TwoWay}"/><CheckBox Content="Paused" IsChecked="{Binding SchedulePaused,Mode=TwoWay}"/><ComboBox Header="Frequency" SelectedValue="{Binding ScheduleFrequency,Mode=TwoWay}" SelectedValuePath="Content" Width="150"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/><ComboBoxItem Content="Custom"/><ComboBoxItem Content="Startup"/><ComboBoxItem Content="Idle"/><ComboBoxItem Content="Maintenance"/></ComboBox><ComboBox Header="Weekly day" SelectedValue="{Binding WeeklyDay,Mode=TwoWay}" SelectedValuePath="Content" Width="130"><ComboBoxItem Content="Sunday"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/></ComboBox><NumberBox Header="Hour (local)" Value="{Binding ScheduleHour,Mode=TwoWay}" Minimum="0" Maximum="23" Width="110"/><NumberBox Header="Monthly day" Value="{Binding MonthlyDay,Mode=TwoWay}" Minimum="1" Maximum="31" Width="110"/><NumberBox Header="Window end hour" Value="{Binding MaintenanceEndHour,Mode=TwoWay}" Minimum="0" Maximum="23" Width="130"/><NumberBox Header="Custom minutes" Value="{Binding CustomIntervalMinutes,Mode=TwoWay}" Minimum="15" Maximum="43200" Width="130"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><CheckBox Content="Only plugged in" IsChecked="{Binding OnlyWhenPluggedIn,Mode=TwoWay}"/><CheckBox Content="Only idle" IsChecked="{Binding OnlyWhenIdle,Mode=TwoWay}"/><CheckBox Content="Require network" IsChecked="{Binding RequireNetwork,Mode=TwoWay}"/><NumberBox Header="Maximum load %" Value="{Binding MaximumLoadPercent,Mode=TwoWay}" Minimum="1" Maximum="100" Width="130"/><Button Content="Save schedule" Command="{Binding SaveScheduleCommand}" AutomationProperties.AutomationId="SaveScheduleButton"/><Button Content="Run now" Command="{Binding RunScheduledCommand}" AutomationProperties.AutomationId="RunScheduledScanButton"/></StackPanel><TextBlock Text="{Binding SchedulePreview}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Recent schedule decisions" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ScheduleHistory}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding EvaluatedAtUtc}" Width="190"/><TextBlock Text="{Binding Outcome}" Width="150"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Width="480"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Crash Analysis" Style="{StaticResource HeaderTextBlockStyle}"/><Button Content="Analyze preserved minidumps" Command="{Binding AnalyzeCrashesCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding CrashGroups}" DisplayMemberPath="Key"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Evidence" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Only finding-related, allow-listed evidence is retained. Secrets and personal content are excluded." TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Evidence}" DisplayMemberPath="Code"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Repair Plan" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="Repairs are prioritized by dependency, benefit, confidence, evidence, risk, reversibility, impact, and restart requirements. Nothing runs without approval." TextWrapping="Wrap"/><Button Content="Review and approve eligible low-risk repairs" Click="OnApproveSafeClick" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding RepairPlan}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4"><TextBlock Text="{Binding Title}" Width="360"/><TextBlock Text="{Binding RiskLevel}" Width="70"/><TextBlock Text="{Binding ExpectedBenefit}" Width="40"/><TextBlock Text="{Binding RankingVersion}" Width="120"/><TextBlock Text="{Binding EstimatedDowntimeMinutes}" Width="40" AutomationProperties.Name="Estimated downtime minutes"/><Button Content="Review details" Click="OnRepairClick"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="Reports" Style="{StaticResource HeaderTextBlockStyle}"/><TextBlock Text="HTML, JSON, ZIP, and PDF reports include health, findings, redacted evidence, root causes, confidence, repair order, repair history, limitations, and a redaction notice." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" AutomationProperties.AutomationId="ExportHtmlButton"/><Button Content="Export JSON" Command="{Binding ExportJsonCommand}" AutomationProperties.AutomationId="ExportJsonButton"/><Button Content="Export ZIP" Command="{Binding ExportPackageCommand}" AutomationProperties.AutomationId="ExportZipButton"/><Button Content="Export PDF" Command="{Binding ExportPdfCommand}" AutomationProperties.AutomationId="ExportPdfButton"/></StackPanel></StackPanel>
  </StackPanel></ScrollViewer>
</Page>
